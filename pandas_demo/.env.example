# ============================================================
# 环境变量配置模板
# 复制本文件为 .env，填入真实值，不要提交 .env 到 Git
# ============================================================

# ---------- PostgreSQL (测试环境) ----------
PG_TEST_HOST=10.10.2.30
PG_TEST_PORT=15432
PG_TEST_DB=labillion-workflow
PG_TEST_USER=postgres
PG_TEST_PASSWORD=your_pg_test_password

# ---------- PostgreSQL (生产环境) ----------
PG_PROD_HOST=10.10.2.15
PG_PROD_PORT=5432
PG_PROD_DB=labillion-workflow
PG_PROD_USER=postgres
PG_PROD_PASSWORD=your_pg_prod_password

# ---------- ClickHouse ----------
CK_HOST=192.168.1.124
CK_PORT=8123
CK_USER=default
CK_PASSWORD=your_ck_password

# ---------- Kafka ----------
KAFKA_BROKERS=192.168.1.124:9092

# ---------- Weaviate ----------
WEAVIATE_HOST=192.168.1.131
WEAVIATE_PORT=18080
WEAVIATE_GRPC_PORT=50051

# ---------- Ollama (本地 LLM) ----------
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Qwen / 阿里云百炼 ----------
MODEL_TYPE=qwen
MODEL_API_KEY=your_qwen_api_key_here
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL_NAME=qwen-turbo
EMBEDDING_MODEL_NAME=text-embedding-v4
RERANK_MODEL_NAME=gte-rerank-v2
MODEL_TEMPERATURE=0.01

# ---------- 视觉模型 ----------
VISION_API_BASE=http://your_vision_server:9304/v1
VISION_MODEL_NAME=Qwen2.5-VL-7B-Instruct

# ---------- Megaauth 认证 ----------
MEGAAUTH_BASE_URL=https://megaauth.data.labillion.cn
MEGAAUTH_API_TOKEN=your_megaauth_token

# ---------- JWT ----------
JWT_SECRET_KEY=your_jwt_secret_key
